---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getNotes } from '../../lib/content';
export async function getStaticPaths() {
  return (await getNotes()).map(note => ({ params: { slug: note.id }, props: { note } }));
}
interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const { Content } = await render(note);
---
<Layout title={note.data.title} description={note.data.summary}>
  <article class="article-page">
    <a class="back-link" href="/notes/">← All notes</a>
    <div class="page-intro"><h1>{note.data.title}</h1><p>{note.data.summary}</p></div>
    {note.data.draft && <p class="draft-label">Draft preview</p>}
    <div class="prose"><Content /></div>
  </article>
</Layout>
