---
import Layout from '../layouts/Layout.astro';
import { liveProjects } from '../data/live-projects';
---
<Layout title="Live projects" description="Open Nick’s browser tools, playable games and demos in one place.">
  <div class="page-intro">
    <h1>Live projects</h1>
    <p>Tools, games and demos you can open right here. Pick a project and try it.</p>
  </div>
  <section class="live-projects" aria-label="Browser projects">
    {liveProjects.map(project => <article class="live-project">
      <div class="live-kind">{project.kind}</div>
      <h2><a href={project.href}>{project.title}</a></h2>
      <p>{project.description}</p>
      <p class="live-detail">{project.detail}</p>
      <div class="live-links">
        <a class="live-open" href={project.href}>{project.action} <span aria-hidden="true">↗</span></a>
        <a class="live-source" href={project.source}>Source code <span aria-hidden="true">↗</span></a>
      </div>
    </article>)}
  </section>
</Layout>
