---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getProjects } from '../../lib/content';
import { withLatestVersion } from '../../lib/github';
export async function getStaticPaths() {
  return (await getProjects()).map(project => ({ params: { slug: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
const status = await withLatestVersion(project.data.status, project.data.repository);
---
<Layout title={project.data.title} description={project.data.summary}>
  <article class="article-page">
    <a class="back-link" href="/projects/">← All projects</a>
    <div class="page-intro"><h1>{project.data.title}</h1><p>{project.data.summary}</p></div>
    <div class="article-meta">
      <table class="spec">
        <tr><th scope="row">Stack</th><td>{project.data.stack.join(' / ')}</td></tr>
        <tr><th scope="row">Role</th><td>{project.data.role}</td></tr>
        <tr><th scope="row">Status</th><td>{status}</td></tr>
        <tr><th scope="row">Source</th><td><a href={project.data.repository} target="_blank" rel="noopener noreferrer">Source on GitHub ↗</a></td></tr>
      </table>
    </div>
    {project.data.draft && <p class="draft-label">Draft preview</p>}
    <div class="prose"><Content /></div>
    {project.data.note && <div class="article-footer"><a class="button primary" href={`/notes/${project.data.note}/`}>Read the post ↗</a></div>}
  </article>
</Layout>
