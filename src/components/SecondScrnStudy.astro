---
import { getEntry } from 'astro:content';
import { getLatestRelease, repoSlug } from '../lib/github';
const project = await getEntry('projects', 'secondscrn');
if (!project) throw new Error('Missing src/content/projects/secondscrn.md');
const slug = repoSlug(project.data.repository);
const release = slug ? await getLatestRelease(slug) : null;
const version = release?.tag ?? project.data.status.match(/v\d+(?:\.\d+)+/)?.[0] ?? '';
// Flag fresh releases for two months, then let the panel settle.
const isNew = release ? Date.now() - release.publishedAt.getTime() < 60 * 24 * 60 * 60 * 1000 : false;
---
<section class="feature secondscrn-study" aria-labelledby="secondscrn-title">
  <div class="feature-text">
    <div class="release-label">{isNew && <span class="marker">New</span>}<span>SecondScrn{version && ` / ${version}`}</span></div>
    <h3 id="secondscrn-title">My tablet is a Windows monitor now.</h3>
    <p>SecondScrn extends my Windows desktop onto an Android tablet over Wi-Fi, with touch and pen pressure coming back the other way.</p>
    <table class="spec">
      <tr><th scope="row">Stack</th><td>{project.data.stack.join(' / ')}</td></tr>
      <tr><th scope="row">Role</th><td>{project.data.role}</td></tr>
    </table>
    <div class="feature-links">
      <a class="text-link" href="/notes/secondscrn/">How I built SecondScrn ↗</a>
      {release && <a class="text-link" href={release.url} target="_blank" rel="noopener noreferrer">Download {release.tag} ↗</a>}
    </div>
  </div>
  <figure class="feature-figure">
      <svg class="display-diagram" viewBox="0 0 500 214" role="img" aria-labelledby="display-diagram-title display-diagram-desc">
        <title id="display-diagram-title">SecondScrn turns an Android tablet into a second Windows monitor</title>
        <desc id="display-diagram-desc">A Windows PC and an Android tablet side by side as display 1 and display 2 of one extended desktop. A single window spans both screens. Video streams from the PC to the tablet over local Wi-Fi, and touch and pen input with pressure goes back to the PC.</desc>
        <defs>
          <marker id="ss-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
            <path d="M1.5 1.5 8 5l-6.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
          <clipPath id="ss-canvas"><rect x="164" y="40" width="80" height="52" /><rect x="330" y="40" width="118" height="52" /><rect x="400" y="10" width="40" height="50" /></clipPath>
          <clipPath id="ss-gap"><rect x="244" y="40" width="86" height="52" /></clipPath>
        </defs>

        <!-- Hardware -->
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <rect x="8" y="8" width="244" height="146" rx="5" />
          <rect class="screen" x="16" y="16" width="228" height="120" />
          <path d="M118 154v18m24-18v18m-42 0h60" stroke-linecap="round" />
          <rect x="318" y="8" width="174" height="122" rx="12" />
          <rect class="screen" x="330" y="16" width="150" height="106" />
          <circle cx="324" cy="69" r="1.4" fill="currentColor" stroke="none" />
        </g>

        <!-- Taskbars: Windows runs on both screens -->
        <g class="taskbar" stroke="currentColor" stroke-width="1">
          <path d="M16 128h228M330 114h150" fill="none" />
          <g fill="currentColor" stroke="none">
            <rect x="117" y="130" width="4.5" height="4.5" /><rect x="124" y="130" width="4.5" height="4.5" opacity=".5" /><rect x="131" y="130" width="4.5" height="4.5" opacity=".5" /><rect x="138" y="130" width="4.5" height="4.5" opacity=".5" />
            <rect x="392" y="116.5" width="3.5" height="3.5" /><rect x="398.5" y="116.5" width="3.5" height="3.5" opacity=".5" /><rect x="405" y="116.5" width="3.5" height="3.5" opacity=".5" /><rect x="411.5" y="116.5" width="3.5" height="3.5" opacity=".5" />
          </g>
        </g>

        <!-- Code editor stays on the PC -->
        <g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <rect class="window-body" x="26" y="26" width="124" height="90" />
          <path d="M26 35h124" fill="none" />
          <path d="M138 28.5l3 3m0-3-3 3" fill="none" stroke-width="1" />
          <path d="M35 46h24m-16 9h40m-40 9h30m-38 9h18m-10 9h48m-56 9h14m-6 9h34" fill="none" stroke-linecap="round" opacity=".5" />
        </g>

        <!-- One window spanning both displays -->
        <g class="span-window" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <path class="window-body" d="M244 30H164V92H244" />
          <path class="window-body" d="M330 30H448V92H330" />
          <rect class="title" x="164" y="30" width="80" height="10" />
          <rect class="title" x="330" y="30" width="118" height="10" />
          <path d="M436 32.5l3.5 3.5m0-3.5-3.5 3.5" fill="none" stroke-width="1" />
          <path d="M170 50h5m-5 7h5m-5 7h5m-5 7h5" fill="none" stroke-width="2" stroke-linecap="round" opacity=".5" />
          <path class="virtual" d="M244 30H330M244 40H330M244 92H330" fill="none" stroke-dasharray="3 3" />
        </g>

        <!-- One pen stroke across both screens; its width follows pen pressure -->
        <g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <path class="ink" d="M186.3 82.1 187.5 79.9 188.8 77.8 190.0 75.8 191.3 74.1 192.5 72.4 193.7 71.0 195.0 69.7 196.2 68.5 197.4 67.5 198.7 66.6 199.9 65.8 201.1 65.1 202.3 64.6 203.5 64.1 204.8 63.8 206.0 63.5 207.2 63.4 208.4 63.3 209.7 63.3 210.9 63.3 212.2 63.5 213.4 63.6 214.7 63.9 216.0 64.2 217.3 64.5 218.6 64.9 220.0 65.4 221.3 65.8 222.7 66.3 224.0 66.8 225.4 67.3 226.8 67.9 228.2 68.4 229.7 69.0 231.1 69.5 232.6 70.1 234.1 70.6 235.6 71.1 237.1 71.6 238.6 72.0 240.2 72.4 241.7 72.8 243.3 73.1 245.0 73.4 246.6 73.6 248.2 73.7 249.9 73.8 251.6 73.8 253.3 73.7 255.1 73.5 256.8 73.3 258.6 72.9 260.4 72.4 262.2 71.8 264.0 71.1 265.8 70.2 267.6 69.3 269.5 68.2 271.4 66.9 273.2 65.6 275.0 64.2 276.8 62.9 278.5 61.7 280.2 60.5 281.9 59.4 283.5 58.3 285.2 57.3 286.8 56.3 288.4 55.4 289.9 54.5 291.5 53.7 293.0 52.9 294.5 52.2 296.0 51.5 297.4 50.9 298.9 50.3 300.3 49.8 301.7 49.3 303.0 48.9 304.4 48.6 305.7 48.2 307.1 48.0 308.4 47.7 309.6 47.6 310.9 47.4 312.2 47.3 313.4 47.3 314.6 47.3 315.8 47.3 317.0 47.4 318.2 47.6 319.4 47.8 320.6 48.0 321.7 48.3 322.9 48.6 324.0 48.9 325.1 49.3 326.3 49.8 327.4 50.3 328.5 50.8 329.6 51.4 330.7 52.0 331.8 52.7 332.9 53.4 334.0 54.2 335.1 55.0 336.2 55.9 337.3 56.8 338.4 57.7 339.5 58.7 340.6 59.8 341.7 60.9 342.8 62.0 343.8 63.2 344.9 64.4 346.0 65.7 347.1 67.0 348.2 68.3 349.3 69.7 350.4 71.2 351.5 72.7 352.7 74.1 353.9 75.4 355.1 76.6 356.3 77.8 357.5 78.9 358.7 79.9 359.9 80.8 361.1 81.6 362.4 82.3 363.6 83.0 364.8 83.6 366.1 84.1 367.4 84.5 368.6 84.9 369.9 85.2 371.1 85.4 372.4 85.6 373.7 85.7 374.9 85.7 376.2 85.6 377.4 85.5 378.7 85.3 379.9 85.1 381.1 84.8 382.4 84.5 383.6 84.1 384.8 83.7 386.0 83.2 387.2 82.6 388.4 82.1 389.6 81.5 390.7 80.8 391.9 80.1 393.1 79.4 394.2 78.6 395.4 77.8 396.5 76.9 397.6 76.1 398.8 75.2 399.9 74.2 401.0 73.3 402.1 72.3 403.2 71.3 404.2 70.3 405.3 69.2 406.4 68.2 407.4 67.1 408.5 66.0 409.5 64.9 410.5 63.7 411.6 62.6 412.6 61.4 413.6 60.3 414.5 59.1 415.5 57.9 416.5 56.8 417.4 55.6