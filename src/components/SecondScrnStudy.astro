<style>
  .release-label {font:11px/1.5 'IBM Plex Mono',monospace;letter-spacing:.04em;margin-bottom:14px;}
  .display-diagram {display:block;width:100%;height:auto;margin:18px 0 6px;overflow:visible;}
  .device-labels {font:11px 'IBM Plex Mono',monospace;}
  .video-layer,.input-layer {opacity:.4;transition:opacity .2s ease;}
  [data-stage="video"] .video-layer,[data-stage="input"] .input-layer {opacity:1;}
  .stream-stages {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-bottom:15px;}
  .stream-stages button {min-height:44px;padding:7px 3px;border:1px solid currentColor;background:transparent;color:inherit;font:11px/1.5 'IBM Plex Mono',monospace;}
  .stream-stages button[aria-pressed="true"] {background:var(--on-accent);color:var(--accent);border-color:var(--on-accent);}
  @media(hover:hover) {.stream-stages button:hover {text-decoration:underline;text-underline-offset:4px;}}
  :global(.site-shell) .stream-caption {font:11px/1.6 'IBM Plex Mono',monospace;min-height:6.4em;margin-bottom:10px;}
  @media(prefers-reduced-motion:reduce) {.video-layer,.input-layer {transition:none;}}
</style>

<script>
  const board = document.querySelector<HTMLElement>('.secondscrn-study');
  if (board) {
    const buttons = [...board.querySelectorAll<HTMLButtonElement>('.stream-stages button')];
    const caption = board.querySelector('#stream-caption');
    const captions: Record<string, string> = {
      display: 'Windows sees another monitor. I can drag a window onto the tablet and keep working with my pen.',
      video: 'The pixels stay on the GPU until they become compressed video. WebRTC carries them to the tablet’s hardware decoder.',
      input: 'A pen stroke takes the return trip over TLS. Windows receives pen input, including pressure, rather than just a mouse click.',
    };
    buttons.forEach(button => button.addEventListener('click', () => {
      const stage = button.dataset.stage;
      if (!stage || !captions[stage]) return;
      board.dataset.stage = stage;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      if (caption) caption.textContent = captions[stage];
    }));
  }
</script>
