          <path class="ink-gap" d="M186 82C210 34 236 92 272 64S330 40 352 70S400 76 419 53" clip-path="url(#ss-gap)" fill="none" stroke-width="1.5" stroke-dasharray="1 3.5" stroke-linecap="round" />
          <path class="pen" d="M419 53 423 44 449 17 456 24 429 50Z" />
          <path d="M423 44 429 50" fill="none" />
        </g>

        <!-- Wireless link -->
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path class="flow" d="M280 108H312" marker-end="url(#ss-arrow)" />
          <path class="flow flow-back" d="M312 124H280" stroke-dasharray="3 3" marker-end="url(#ss-arrow)" />
          <path d="M288.5 145.5a12 12 0 0 1 17 0M291.3 148.3a8 8 0 0 1 11.4 0M294.2 151.2a4 4 0 0 1 5.6 0" />
          <circle cx="297" cy="154" r="1.4" fill="currentColor" stroke="none" />
        </g>

        <!-- Callouts, explained in the legend -->
        <g class="callouts" font-size="9" text-anchor="middle">
          <g><rect x="274" y="55" width="22" height="12" /><text x="285" y="63.8">01</text></g>
          <g><rect x="254" y="102" width="22" height="12" /><text x="265" y="110.8">02</text></g>
          <g><rect x="254" y="118" width="22" height="12" /><text x="265" y="126.8">03</text></g>
        </g>

        <g class="device-labels" font-size="12" text-anchor="middle">
          <text x="130" y="192" fill="currentColor">Windows PC</text>
          <text class="sub" x="130" y="207">display 1</text>
          <text x="405" y="150" fill="currentColor">Android tablet</text>
          <text class="sub" x="405" y="165">display 2</text>
          <text class="sub" x="297" y="174">local Wi-Fi</text>
        </g>
      </svg>
      <ol class="figure-notes">
        <li><span class="note-n">01</span><p>Windows sees another monitor, so I can drag windows onto the tablet and draw or tap with my pen.</p></li>
        <li><span class="note-n">02</span><p>Frames stay on the GPU through hardware encoding, then stream over WebRTC to Android’s hardware decoder.</p></li>
        <li><span class="note-n">03</span><p>Touch and pen strokes travel back over TLS and are injected as native Windows pen input with pressure, not simulated mouse clicks.</p></li>
      </ol>
  </figure>
</section>

<style>
  .feature {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);border:1px solid var(--ink);}
  .feature-text {display:flex;flex-direction:column;gap:12px;padding:26px;border-right:1px solid var(--ink);}
  .release-label {display:flex;align-items:center;gap:10px;font:12.5px/1.5 var(--mono);color:var(--quiet);}
  .feature h3 {font-size:36px;line-height:1.05;}
  .feature p {color:var(--quiet);font-size:16px;max-width:46ch;}
  .feature .spec {margin-top:auto;}
  .feature-links {display:flex;flex-wrap:wrap;gap:8px 22px;}
  .feature-figure {display:flex;flex-direction:column;min-width:0;}
  .display-diagram {display:block;width:100%;height:auto;padding:22px 22px 12px;overflow:visible;font-family:var(--mono);}
  .display-diagram .screen {fill:var(--panel);}
  .display-diagram .window-body {fill:var(--paper);}
  .display-diagram .title {fill:var(--yellow);}
  .display-diagram .pen {fill:var(--paper);}
  .display-diagram .taskbar,.display-diagram .virtual {opacity:.6;}
  .callouts rect {fill:var(--yellow);stroke:var(--on-yellow);stroke-width:1;}
  .callouts text {fill:var(--on-yellow);}
  .device-labels .sub {fill:var(--quiet);}
  .flow {stroke-dasharray:6 4;}
  .flow-back {stroke-dasharray:3 3;}
  @media(prefers-reduced-motion:no-preference) {
    .flow {animation:ss-flow 1s linear infinite;}
    .flow-back {animation-name:ss-flow-back;animation-duration:.6s;}
  }
  @keyframes ss-flow {to {stroke-dashoffset:-10;}}
  /* One loop must move exactly one dash period (3+3), or the line jumps on repeat. */
  @keyframes ss-flow-back {to {stroke-dashoffset:-6;}}
  .figure-notes {list-style:none;margin:auto 0 0;padding:0;border-top:1px solid var(--ink);}
  .figure-notes li {display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;align-items:baseline;padding:9px 14px;border-top:1px solid var(--line);}
  .figure-notes li:first-child {border-top:0;}
  .note-n {background:var(--yellow);color:var(--on-yellow);font:11px/1.6 var(--mono);text-align:center;}
  .feature .figure-notes p {max-width:none;font-size:13.5px;line-height:1.5;color:var(--quiet);}
  @media(max-width:960px) {
    .feature {grid-template-columns:1fr;}
    .feature-text {border-right:0;border-bottom:1px solid var(--ink);}
  }
  @media(max-width:680px) {
    .feature-text {padding:20px;}
    .feature h3 {font-size:30px;}
    .display-diagram {padding:16px 12px 8px;}
    .figure-notes li {padding:9px 12px;}
  }
</style>
